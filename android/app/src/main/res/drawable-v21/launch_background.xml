<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch screen, API 21+ — the one virtually every device actually uses.

  See the pre-v21 sibling for why `?android:colorBackground` had to go: it
  resolves to white under the light `LaunchTheme`, which is what made a
  dark-only app open with a white flash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_black" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
