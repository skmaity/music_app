<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, API 26+. Without this the launcher takes the legacy square
  mipmap and either shrinks it inside a white backdrop or masks it blindly —
  a visibly second-rate icon on every Android 8 or newer device, which is all
  of them.

  Two layers on purpose: the foreground PNGs are transparent apart from the
  mark, so a launcher that animates the layers apart moves the mark over the
  field rather than sliding a black square around.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
