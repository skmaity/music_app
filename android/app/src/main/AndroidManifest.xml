<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Playback continues with the app backgrounded and the screen locked, which
      on Android means a foreground service holding a media session.

      FOREGROUND_SERVICE_MEDIA_PLAYBACK is not optional from Android 14 on: a
      foreground service must declare a type, and starting one whose type is
      undeclared throws. build.gradle takes targetSdk from
      flutter.targetSdkVersion, which is past 34.

      POST_NOTIFICATIONS is Android 13+. Without it the service still runs and
      audio still plays — only the card is hidden, which is the confusing
      failure to check first if playback works but nothing appears in the shade.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
      READ_EXTERNAL_STORAGE and READ_MEDIA_AUDIO were declared here and never
      used: nothing in lib/ opens a local file, and every track is streamed
      from the API. Both are "sensitive" permissions on the Play Console —
      they trigger a declaration form and are a routine rejection cause — so
      shipping them to buy nothing was a bad trade. If local-file playback is
      ever added, READ_MEDIA_AUDIO is the one to bring back (API 33+), with
      READ_EXTERNAL_STORAGE limited to maxSdkVersion="32".

      usesCleartextTraffic was also removed. It permitted plain HTTP for the
      whole app, and there is none: apis/all_urls.dart builds every URL from
      an https host, and both the stream and the cover art are relative paths
      prefixed with it (song_controller.dart's setUrl, RemoteImage's url).
    -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:label="Nyro"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
          audio_service's media session, reached through just_audio_background.
          This is what keeps the process alive with the screen off and what
          draws the notification card.

          MediaButtonReceiver is what routes a bluetooth remote's or a wired
          headset's transport buttons back into the player. Without it the card
          works but the buttons on the headphones do nothing.

          audio_service ships these nodes in its own manifest too. If a build
          ever fails on a manifest-merger conflict here, that is the merger
          telling you the library already contributed the node — delete ours
          rather than forcing it through with tools:replace.
        -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
